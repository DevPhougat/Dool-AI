# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only (never prefix with NEXT_PUBLIC_)
# No Supabase service-role key is needed: Row Level Security does the protecting.
AI_PROVIDER=anthropic        # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional. Check the exact model name in your provider's console before relying on the default.
# Defaults: claude-haiku-5-5 (anthropic), gpt-4o-mini (openai)
AI_MODEL=
# Optional per-visitor limits (per IP address)
AI_PER_MINUTE_LIMIT=8
AI_DAILY_LIMIT=40
